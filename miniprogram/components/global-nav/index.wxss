.nav{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #dfe7e5;padding:20rpx 12rpx calc(20rpx + env(safe-area-inset-bottom));z-index:20}.tab{flex:1;text-align:center;color:#71817c;position:relative;font-size:27rpx}.selected{color:#086f5c;font-weight:700}.dot{position:absolute;background:#df554a;border-radius:50%;width:13rpx;height:13rpx;right:42rpx;top:0}
