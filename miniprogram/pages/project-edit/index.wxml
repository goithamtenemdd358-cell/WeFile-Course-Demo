<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><text class="badge">{{draft.saved?'已保存草稿':'未发布编辑'}}</text><text class="label">项目名称（选填）</text><input value="{{form.name}}" bindinput="input" data-field="name" data-form="true" maxlength="80"/><text class="label">项目简介</text><textarea value="{{form.description}}" bindinput="input" data-field="description" data-form="true" maxlength="2000"/><text class="label">项目统一要求</text><textarea value="{{form.unifiedRequirements}}" bindinput="input" data-field="unifiedRequirements" data-form="true" maxlength="4000"/><text class="label">最终成果要求</text><textarea value="{{form.finalRequirements}}" bindinput="input" data-field="finalRequirements" data-form="true" maxlength="4000"/><text class="label">截止时间（北京时间，选填）</text><view class="row"><picker mode="date" value="{{date}}" bindchange="pick" data-field="date">{{date || '选择日期'}}</picker><picker mode="time" value="{{clock}}" bindchange="pick" data-field="clock">{{clock || '23:59'}}</picker></view><image wx:if="{{coverUrl}}" class="cover" src="{{coverUrl}}" mode="aspectFill"/><button class="action-button " bindtap="action" data-action="chooseCover"  disabled="{{busy || submissionSucceeded}}">上传项目封面</button><view class="section">参考文档</view><button class="action-button " bindtap="action" data-action="chooseReference"  disabled="{{busy || submissionSucceeded}}">选择参考文档</button><view wx:if="{{referenceName}}" class="card"><text>{{referenceName}}</text><text class="label">文件分类</text><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" data-field="categoryIndex" bindchange="pick">{{categories[categoryIndex].label}}</picker><text class="label">文件说明</text><textarea value="{{referenceDescription}}" bindinput="input" data-field="referenceDescription"  maxlength="2000"/><button class="action-button " bindtap="action" data-action="attachReference"  disabled="{{busy || submissionSucceeded}}">上传参考文档</button></view><view wx:for="{{referenceInputs}}" wx:key="revisionId" class="file"><text>{{referenceNames[item.revisionId] || '参考文档'}} · {{item.description}} · {{item.category}}</text><button class="action-button " bindtap="action" data-action="removeDraftReference" data-index="{{index}}" disabled="{{busy || submissionSucceeded}}">移除选中文档</button></view><button class="action-button " bindtap="action" data-action="saveProjectDraft"  disabled="{{busy || submissionSucceeded}}">保存草稿</button><button class="action-button primary" bindtap="action" data-action="publishProject"  disabled="{{busy || submissionSucceeded}}">{{draft.mode==='EDIT' ? '保存项目信息' : '创建项目'}}</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="05"/>
