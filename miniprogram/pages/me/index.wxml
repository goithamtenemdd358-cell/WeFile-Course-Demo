<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card hero"><image wx:if="{{avatarUrl}}" src="{{avatarUrl}}" class="avatar"/><view wx:else class="avatar row">我</view><view class="title">{{user.displayName}}</view><button bindtap="go" data-page="02" >编辑资料</button></view><view class="section">我的待处理任务（{{todoCount || 0}}）</view><view class="filters"><view class="filter {{filter==='pending'?'active':''}}" bindtap="filter" data-value="pending">待提交 {{pendingCount || 0}}</view><view class="filter {{filter==='changes'?'active':''}}" bindtap="filter" data-value="changes">待修改 {{changesCount || 0}}</view></view><view wx:for="{{items}}" wx:key="taskId" class="card"><view bindtap="go" data-page="12" data-task="{{item.taskId}}" data-project="{{item.projectId}}"><view class="card-title">{{item.title}}</view><view class="muted">{{item.projectName}} {{item.assigneeDisplayName}}</view><text class="badge">{{item.stateText}}</text><text wx:if="{{item.isOverdue}}" class="badge late">已逾期</text><view class="muted">DDL {{item.effectiveDueAtText || item.dueAtText}}</view><view wx:if="{{item.currentSubmission}}" class="muted">V{{item.currentSubmission.displayNumber}} · {{item.currentSubmission.submittedAtText}}</view></view><block wx:if="{{pageId==='02-A' || pageId==='11'}}"><button bindtap="go" data-page="13" wx:if="{{item.quickAction==='FIRST_UPLOAD' || item.capabilities.canFirstUpload}}" data-task="{{item.taskId}}" data-project="{{item.projectId}}">上传文件</button><button bindtap="go" data-page="20" wx:if="{{item.quickAction==='RESUBMIT' || item.capabilities.canResubmit}}" data-task="{{item.taskId}}" data-project="{{item.projectId}}">重新提交</button></block><block wx:if="{{pageId==='15'}}"><button bindtap="go" data-page="14" data-task="{{item.taskId}}">修改任务</button><button class="action-button " bindtap="action" data-action="preview" wx:if="{{item.currentSubmission}}" data-kind="submission" data-id="{{item.currentSubmission.submissionId}}" data-expected="{{item.currentSubmission.revisionId}}" disabled="{{busy || submissionSucceeded}}">查看文件</button><button bindtap="go" data-page="16" wx:if="{{item.capabilities.canApprove}}" data-task="{{item.taskId}}">开始审核</button><button class="action-button " bindtap="action" data-action="remind" wx:if="{{item.capabilities.canRemind}}" data-id="{{item.taskId}}" data-revision="{{item.revision}}" disabled="{{busy || submissionSucceeded}}">提醒提交</button></block></view><view wx:if="{{!items.length && !loading}}" class="empty">暂无任务</view><view class="card"><view class="card-title">邀请体验成员</view><view class="muted">对方先由管理员加入体验成员，再通过微信分享打开体验版。</view><button class="primary" open-type="share">分享小程序体验版</button></view><button class="action-button " bindtap="action" data-action="agreement"  disabled="{{busy || submissionSucceeded}}">用户协议</button><button class="action-button " bindtap="action" data-action="privacy"  disabled="{{busy || submissionSucceeded}}">隐私政策</button><button class="action-button " bindtap="action" data-action="logout"  disabled="{{busy || submissionSucceeded}}">退出登录</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="02-A"/>
