.home-dashboard{min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx 178rpx;background:radial-gradient(circle at 50% 0,#edf8f4 0,#f7faf9 32%,#f4f7f6 100%)}.home-head{height:96rpx;display:flex;align-items:center;justify-content:space-between;margin:0 4rpx 54rpx}.home-mark{width:82rpx;font-size:49rpx;color:#0f2d26;text-align:left;line-height:1}.home-brand{font-size:43rpx;font-weight:800;color:#102721}.home-message{width:82rpx;text-align:right;font-size:23rpx;color:#628078;position:relative}.home-message-dot{position:absolute;width:14rpx;height:14rpx;border-radius:50%;background:#e8524b;right:-4rpx;top:-7rpx}.home-page-title{font-size:48rpx;font-weight:800;color:#075445;margin:0 2rpx 34rpx}.home-hero{min-height:326rpx;position:relative;overflow:hidden;border-radius:30rpx;background:linear-gradient(135deg,#057461 0%,#006858 60%,#00836b 100%);box-shadow:0 18rpx 36rpx rgba(2,95,76,.15);color:#fff}.home-orb{position:absolute;border-radius:50%;background:rgba(135,232,203,.09)}.home-orb-one{width:360rpx;height:360rpx;right:-170rpx;top:-170rpx}.home-orb-two{width:480rpx;height:480rpx;left:-300rpx;bottom:-390rpx}.home-hero-copy{position:relative;padding:46rpx 36rpx}.home-avatar{width:108rpx;height:108rpx;border-radius:50%;background:#cde8df;border:4rpx solid rgba(255,255,255,.2);display:block}.home-avatar-fallback{display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:700}.home-greeting{font-size:48rpx;font-weight:800;line-height:1.2;margin-top:27rpx;word-break:break-all}.home-subtitle{font-size:29rpx;color:#d5eee6;margin-top:12rpx}.home-stats{margin:28rpx 0 34rpx;padding:30rpx 20rpx;background:#fff;border:1rpx solid #e2ece8;border-radius:27rpx;display:flex;box-shadow:0 9rpx 20rpx rgba(15,78,63,.04)}.home-stat{width:25%;padding:0 10rpx;box-sizing:border-box}.home-stat-number{font-size:52rpx;line-height:1;color:#075a4a;font-weight:800}.home-stat text{display:block;font-size:27rpx;color:#294f46;margin-top:15rpx;white-space:nowrap}.home-empty{background:#edf7f3;border-radius:17rpx;padding:24rpx 28rpx;color:#51726a;font-size:25rpx;line-height:1.6;margin:-4rpx 0 28rpx}.home-actions{width:72%;margin:0 auto}.home-actions button{height:104rpx;min-height:104rpx;border-radius:18rpx;margin:18rpx 0;font-size:31rpx;font-weight:750}.home-primary,.home-secondary{background:linear-gradient(135deg,#eff8f5,#e0efea)!important;color:#075646!important;border:0}.home-primary{box-shadow:0 10rpx 20rpx rgba(6,91,72,.06)}.home-secondary{font-size:28rpx!important}@media (max-width:360px){.home-greeting{font-size:43rpx}.home-stat text{font-size:23rpx}.home-actions{width:86%}}