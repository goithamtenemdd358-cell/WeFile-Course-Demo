<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="row"><text>未读 {{unread}}</text><button class="action-button " bindtap="action" data-action="readAll"  disabled="{{busy || submissionSucceeded}}">全部已读</button></view><view class="filters"><view class="filter" bindtap="filter" data-value="ALL">全部</view><view class="filter" bindtap="filter" data-value="TASK">任务通知</view><view class="filter" bindtap="filter" data-value="FEEDBACK">修改意见</view><view class="filter" bindtap="filter" data-value="REVIEW_RESULT">审核结果</view></view><view wx:for="{{items}}" wx:key="notificationId" class="card {{item.isRead?'':'notice-unread'}}" bindtap="action" data-action="notice" data-id="{{item.notificationId}}"><view class="card-title">{{item.eventText}}</view><view>{{item.projectName}} · {{item.taskTitle}}</view><view class="muted">{{item.senderDisplayName}} · {{item.eventAtText}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无通知</view><view class="footer-note">纯站内通知；不会发送微信系统推送。</view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="18"/>
