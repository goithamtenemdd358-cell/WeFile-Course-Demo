<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><text class="muted">姓名与头像都可不填；空姓名会显示为“微信用户”。</text><button open-type="chooseAvatar" bindchooseavatar="avatar"><image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}"/><text wx:else>选择头像</text></button><text class="label">姓名 / 昵称（选填）</text><input value="{{form.displayName}}" bindinput="input" data-field="displayName" data-form="true" maxlength="40"/><button class="action-button primary" bindtap="action" data-action="saveProfile"  disabled="{{busy || submissionSucceeded}}">保存并进入</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="02"/>
