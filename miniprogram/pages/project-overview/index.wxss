.project-dashboard{padding:20rpx 28rpx 176rpx;background:radial-gradient(circle at 50% 0,#edf8f4 0,#f6f9f8 34%,#f3f6f5 100%);min-height:100vh;box-sizing:border-box}.overview-head{height:94rpx;display:flex;align-items:center;justify-content:space-between;margin:4rpx 4rpx 20rpx}.overview-back{font-size:65rpx;line-height:1;font-weight:300;width:80rpx;color:#102b25}.overview-brand{font-size:43rpx;font-weight:750;color:#0d2520;letter-spacing:.5rpx}.overview-role{width:80rpx;text-align:right;font-size:23rpx;color:#688078}.project-hero{position:relative;overflow:hidden;border-radius:30rpx;background:linear-gradient(135deg,#006a58 0%,#005f51 58%,#007761 100%);box-shadow:0 20rpx 36rpx rgba(0,83,66,.18);color:#fff;min-height:690rpx}.project-hero-cover{position:absolute;inset:0;width:100%;height:100%;opacity:.26;border-radius:0}.project-hero-shade{position:absolute;inset:-100rpx -200rpx auto auto;width:480rpx;height:480rpx;border-radius:50%;background:rgba(105,212,177,.13);box-shadow:-230rpx 510rpx 0 120rpx rgba(94,205,165,.08)}.project-hero-content{position:relative;padding:42rpx 34rpx 30rpx}.hero-top{display:flex;justify-content:space-between;align-items:center}.hero-kicker{font-size:23rpx;letter-spacing:3rpx;color:#bce9db}.hero-edit{width:auto;min-height:66rpx;margin:0;padding:0 23rpx;border:2rpx solid rgba(255,255,255,.48);border-radius:34rpx;background:rgba(0,62,51,.2);color:#fff;font-size:26rpx}.project-name{font-size:49rpx;line-height:1.25;font-weight:800;margin:36rpx 0 18rpx;word-break:break-all}.project-description{font-size:28rpx;line-height:1.65;color:#e5f5ef;min-height:88rpx;white-space:pre-wrap}.hero-meta-grid{display:flex;flex-wrap:wrap;margin:32rpx 0 20rpx}.hero-meta{width:50%;display:flex;gap:16rpx;margin-bottom:22rpx;box-sizing:border-box}.hero-icon{font-size:39rpx;line-height:1;color:#d4f3e8}.hero-meta text{display:block;font-size:22rpx;color:#b9e7d9}.hero-value{display:block;font-size:27rpx;color:#fff;margin-top:5rpx;font-weight:700;max-width:245rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.hero-deadline{font-size:27rpx;color:#d6eee6;margin-bottom:30rpx}.hero-deadline text{color:#ffe275;font-weight:800;font-size:31rpx}.hero-divider{height:1rpx;background:rgba(255,255,255,.31);margin:0 -4rpx 25rpx}.reference-title-row{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:700}.reference-title-row text{color:#c5ecdf}.reference-title-row view:last-child{font-size:25rpx;color:#d8f1e9;font-weight:500}.reference-strip{white-space:nowrap;width:100%;margin-top:22rpx}.reference-chip,.reference-add,.reference-empty{display:inline-flex;vertical-align:top;box-sizing:border-box;height:126rpx;border-radius:17rpx;margin-right:16rpx;background:rgba(255,255,255,.13);padding:18rpx;white-space:normal}.reference-chip{width:300rpx;gap:15rpx}.file-type{width:60rpx;height:60rpx;border-radius:12rpx;background:#3678ed;color:#fff;font-size:20rpx;font-weight:800;display:flex;align-items:center;justify-content:center;word-break:break-all;text-align:center}.reference-copy{min-width:0;flex:1}.reference-copy view{font-size:24rpx;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.reference-copy text{font-size:21rpx;color:#c9e8df;display:block;margin-top:8rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.reference-add{width:188rpx;align-items:center;justify-content:center;gap:10rpx;color:#fff;font-size:25rpx}.reference-add text{font-size:46rpx;font-weight:300}.reference-empty{align-items:center;color:#d4ebe4;font-size:24rpx}.dashboard-stats{background:#fff;border:1rpx solid #dfebe6;border-radius:26rpx;margin:28rpx 0 42rpx;padding:26rpx 22rpx 18rpx;display:flex;flex-wrap:wrap;box-shadow:0 8rpx 18rpx rgba(18,70,57,.04)}.dashboard-stat{width:25%;padding:0 10rpx 24rpx;box-sizing:border-box}.dashboard-number{display:block;font-size:48rpx;line-height:1;color:#075a4a;font-weight:700}.dashboard-stat text{font-size:24rpx;color:#345a50;margin-top:12rpx;display:block}.dashboard-progress{width:100%;border-top:1rpx solid #e5eeea;padding:21rpx 10rpx 2rpx;text-align:right;color:#788b85;font-size:24rpx}.dashboard-section-title{font-size:38rpx;font-weight:800;color:#075646;margin:0 8rpx 22rpx}.quick-grid{display:flex;flex-wrap:wrap;gap:18rpx;margin-bottom:44rpx}.quick-card{width:calc(50% - 9rpx);min-height:144rpx;box-sizing:border-box;border-radius:20rpx;background:linear-gradient(135deg,#edf8f4,#e1f0eb);display:flex;align-items:center;gap:14rpx;padding:21rpx;position:relative}.quick-card-wide{width:100%}.quick-card view{min-width:0;flex:1}.quick-label{font-size:28rpx;color:#075747;font-weight:700;display:block}.quick-card text:not(.quick-icon):not(.quick-arrow){display:block;font-size:22rpx;color:#718983;margin-top:7rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.quick-icon{width:54rpx;height:54rpx;box-sizing:border-box;border:3rpx solid #05705b;border-radius:12rpx;color:#05705b;font-size:34rpx;display:flex;align-items:center;justify-content:center;flex:none}.quick-icon-solid{border:0;border-radius:50%;background:#05705b;color:#fff;font-size:48rpx;font-weight:300}.quick-arrow{font-size:47rpx!important;line-height:1;color:#7f948e!important;margin:0!important;flex:none}.dashboard-task{background:#fff;border:1rpx solid #e0ebe6;border-radius:19rpx;padding:23rpx;margin-bottom:16rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx}.dashboard-task-title{font-weight:750;font-size:29rpx;color:#173f36;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420rpx}.dashboard-task-meta{font-size:23rpx;color:#71857f;margin-top:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:430rpx}.dashboard-task-state{display:flex;align-items:center;gap:7rpx}.dashboard-task-state .quick-arrow{margin-left:4rpx!important}.dashboard-empty{background:#fff;border-radius:20rpx;padding:45rpx}.project-dashboard .badge{white-space:nowrap}.project-dashboard .late{margin-left:0}@media (max-width:360px){.project-name{font-size:43rpx}.hero-meta{width:100%}.quick-card{width:100%}.dashboard-stat{width:33.33%}}