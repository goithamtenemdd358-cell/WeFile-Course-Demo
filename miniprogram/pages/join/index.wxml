<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><text class="label">六位邀请码</text><input value="{{code}}" bindinput="input" data-field="code"  maxlength="6"/><button class="action-button primary" bindtap="action" data-action="lookup"  disabled="{{busy || submissionSucceeded}}">查找项目</button><view wx:if="{{preview}}"><view class="card-title">{{preview.projectName}}</view><view>{{preview.description}}</view><view class="muted">组长 {{preview.ownerDisplayName}} · DDL {{preview.dueAtText}}</view><button class="action-button primary" bindtap="action" data-action="join"  disabled="{{busy || submissionSucceeded}}">加入项目</button></view><button class="action-button " bindtap="action" data-action="resetInvite"  disabled="{{busy || submissionSucceeded}}">重新输入</button><button bindtap="go" data-page="03" >返回首页</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="04"/>
