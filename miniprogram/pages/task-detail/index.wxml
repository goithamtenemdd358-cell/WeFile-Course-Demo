<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view wx:if="{{task}}" class="card"><view class="title">{{task.title}}</view><view class="muted">负责人 {{task.assigneeDisplayName}} · DDL {{task.effectiveDueAtText}}</view><text class="badge">{{task.stateText}}</text><text wx:if="{{task.isOverdue}}" class="badge late">{{task.state==='SUBMITTED'||task.state==='DONE'?'已逾期（逾期提交）':'已逾期'}}</text><block wx:if="{{task.view==='FULL'}}"><text class="label">任务描述</text><view class="body">{{task.description}}</view><text class="label">成果要求</text><view class="body">{{task.requirements}}</view><view wx:if="{{task.currentSubmission}}" class="file"><text>V{{task.currentSubmission.displayNumber}} · {{task.currentSubmission.submittedAtText}}</text><button class="action-button " bindtap="action" data-action="preview" data-kind="submission" data-id="{{task.currentSubmission.submissionId}}" data-expected="{{task.currentSubmission.revisionId}}" disabled="{{busy || submissionSucceeded}}">查看文件</button><button class="action-button " bindtap="action" data-action="download" data-kind="submission" data-id="{{task.currentSubmission.submissionId}}" data-expected="{{task.currentSubmission.revisionId}}" disabled="{{busy || submissionSucceeded}}">下载文件</button><button class="action-button " bindtap="action" data-action="versions"  disabled="{{busy || submissionSucceeded}}">查看历史版本</button></view><view wx:if="{{task.draft}}"><text>已保存但未提交：{{task.draft.mode==='OVERWRITE'?'覆盖原有文档':task.draft.mode==='KEEP'?'保留原文档':'首次交付'}}</text><button class="action-button " bindtap="action" data-action="preview" data-kind="taskDraft" data-id="{{task.taskId}}" disabled="{{busy || submissionSucceeded}}">查看草稿</button></view><view wx:if="{{task.latestFeedback}}" class="body">最新修改意见：{{task.latestFeedback.reason}}</view><button bindtap="go" data-page="13" wx:if="{{task.capabilities.canFirstUpload}}">上传文件</button><button class="action-button " bindtap="action" data-action="saveSubmission" wx:if="{{task.capabilities.canSaveDraft}}" disabled="{{busy || submissionSucceeded}}">保存但不提交</button><button class="action-button primary" bindtap="action" data-action="submit" wx:if="{{task.capabilities.canSubmit}}" disabled="{{busy || submissionSucceeded}}">提交审核</button><button bindtap="go" data-page="19" wx:if="{{task.capabilities.canViewFeedback}}" data-review="{{task.latestFeedback.reviewId}}">查看修改意见</button><button bindtap="go" data-page="20" wx:if="{{task.capabilities.canResubmit}}">重新提交</button><block wx:if="{{task.capabilities.canManage}}"><button bindtap="go" data-page="14" data-task="{{task.taskId}}">编辑任务</button><button bindtap="go" data-page="14" data-task="{{task.taskId}}">修改负责人</button><button bindtap="go" data-page="14" data-task="{{task.taskId}}">修改DDL</button><button bindtap="go" data-page="16" wx:if="{{task.capabilities.canApprove}}" data-task="{{task.taskId}}">开始审核</button><button class="action-button " bindtap="action" data-action="deleteTask"  disabled="{{busy || submissionSucceeded}}">删除任务</button></block></block><view wx:else class="muted">公开分工摘要；文件和意见仅任务负责人及组长可见。</view></view><view wx:if="{{showVersions}}" class="card"><picker wx:if="{{leaderHistory}}" range="{{epochs}}" value="{{epochIndex}}" bindchange="historyEpoch">{{epochs[epochIndex]}}</picker><view wx:for="{{versions}}" wx:key="visibleVersionId" class="file"><text>V{{item.displayNumber}} · {{item.name}}</text><view class="muted">{{item.submittedAtText}}</view><button class="action-button " bindtap="action" data-action="preview" data-kind="version" data-id="{{item.visibleVersionId}}" data-expected="{{item.revisionId}}" disabled="{{busy || submissionSucceeded}}">查看历史文件</button></view></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="12"/>
