<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><view class="title">{{project.fields.name}}</view><text class="label">背景简介</text><view class="body">{{project.fields.description}}</view><text class="label">统一要求</text><view class="body">{{project.fields.unifiedRequirements}}</view><text class="label">最终成果要求</text><view class="body">{{project.fields.finalRequirements}}</view><view class="muted">DDL {{project.fields.dueAtText}}<view>组长 {{project.ownerDisplayName}} · 创建于 {{project.createdAtText}}</view></view></view><view class="section">参考文档</view><view wx:for="{{references}}" wx:key="referenceId" class="card"><view class="card-title">{{item.name}}</view><view class="muted">{{item.description || '未填写说明'}}</view></view><view wx:if="{{!references.length}}" class="empty">暂无参考文档</view><button bindtap="go" data-page="10" >查看总体任务</button><button bindtap="go" data-page="09" >查看参考文档</button><button bindtap="go" data-page="07" >返回项目</button><button bindtap="go" data-page="05" wx:if="{{isLeader}}">编辑项目信息</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="08"/>
