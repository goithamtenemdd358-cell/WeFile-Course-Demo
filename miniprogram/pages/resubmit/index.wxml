<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><view class="card-title">{{task.title}}</view><view class="muted">DDL {{task.effectiveDueAtText}}</view><block wx:if="{{pageId==='20'}}"><view>原版本 V{{task.currentSubmission.displayNumber}}</view><view class="body">{{task.latestFeedback.reason}}</view><view class="muted">修改DDL {{task.latestFeedback.effectiveDueAtText}}</view></block></view><view class="card"><button class="action-button " bindtap="action" data-action="chooseFile"  disabled="{{busy || submissionSucceeded}}">{{pageId==='20'?'选择修改文件':'选择文件'}}</button><button class="action-button " bindtap="action" data-action="chooseFile" wx:if="{{fileName}}" disabled="{{busy || submissionSucceeded}}">重新选择</button><view>{{fileName || (task.draft ? '已恢复云端保存稿件' : '尚未选择文件')}}</view><view class="muted">{{fileSize || ''}} 字节 · 单文件上限20MiB</view><progress percent="{{progress}}" show-info activeColor="#0c7660"/><text class="label">提交 / 修改说明</text><textarea value="{{note}}" bindinput="input" data-field="note"  maxlength="4000"/><radio-group wx:if="{{pageId==='20'}}" bindchange="selectMode"><label class="radio-row"><radio value="KEEP" checked="{{mode==='KEEP'}}"/>保留原文档（推荐）</label><label class="radio-row"><radio value="OVERWRITE" checked="{{mode==='OVERWRITE'}}"/>覆盖原有文档</label></radio-group><button class="action-button " bindtap="action" data-action="saveSubmission"  disabled="{{busy || submissionSucceeded}}">保存但不提交</button><button class="action-button primary" bindtap="action" data-action="submit"  disabled="{{busy || submissionSucceeded}}">{{pageId==='20' ? '上传并重新提交' : '上传并提交审核'}}</button><button bindtap="back">取消</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="20"/>
