<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view wx:for="{{items}}" wx:key="projectId" class="card" bindtap="go" data-page="07" data-project="{{item.projectId}}"><view class="card-title">{{item.name}}</view><text class="badge">{{item.myRole==='LEADER'?'组长':'组员'}}</text><view class="muted">总DDL {{item.dueAtText}}</view><progress percent="{{item.progress}}" activeColor="#0c7660" show-info/><view>{{item.statusText}}</view></view><view wx:if="{{!items.length}}" class="empty">暂无项目<button bindtap="go" data-page="03" >去首页创建或加入项目</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="03-A"/>
