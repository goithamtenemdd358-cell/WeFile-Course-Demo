<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><view class="title">{{feedback.taskTitle}}</view><view>{{feedback.projectName}} · 组长 {{feedback.leaderDisplayName}}</view><view>绑定 V{{feedback.displayNumber}} · 原提交 {{feedback.originalSubmittedAtText}}</view><view class="body">{{feedback.reason}}</view><view class="muted">重要程度 {{feedback.priority==='URGENT'?'紧急':feedback.priority==='IMPORTANT'?'重要':'普通'}}<view>新DDL {{feedback.newDueAtText || '未调整'}}</view><view>发送时间 {{feedback.reviewedAtText}}</view></view><view wx:if="{{feedback.fileAvailability==='AUDIT_ONLY'}}" class="muted">该次文件已覆盖，审计留存</view></view><button bindtap="go" data-page="07" >进入项目</button><button bindtap="go" data-page="12" >查看任务</button><button bindtap="go" data-page="20" wx:if="{{feedback.canResubmit}}">重新提交</button><button class="action-button " bindtap="action" data-action="acknowledge"  disabled="{{busy || submissionSucceeded}}">我知道了</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="19"/>
