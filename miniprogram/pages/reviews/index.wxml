<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="filters"><view class="filter {{filter==='PENDING'?'active':''}}" bindtap="filter" data-value="PENDING">待审核</view><view class="filter {{filter==='APPROVED'?'active':''}}" bindtap="filter" data-value="APPROVED">已通过</view><view class="filter {{filter==='REJECTED'?'active':''}}" bindtap="filter" data-value="REJECTED">已退回</view></view><view wx:for="{{items}}" wx:key="submissionId" class="card"><view class="card-title">{{item.taskTitle}} · {{item.assigneeDisplayName}}</view><view>V{{item.submission.displayNumber}} · {{item.submission.submittedAtText}}</view><text wx:if="{{item.submission.submittedLate}}" class="badge late">逾期提交</text><text class="label">提交时任务要求</text><view class="body">{{item.submission.taskRequirementsSnapshot.description}}<view>{{item.submission.taskRequirementsSnapshot.requirements}}</view><view>{{item.submission.taskRequirementsSnapshot.projectUnifiedRequirements}}</view></view><text class="label">提交说明</text><view class="body">{{item.submission.note}}</view><block wx:if="{{item.submission.fileAvailability==='VISIBLE'}}"><button class="action-button " bindtap="action" data-action="preview" data-kind="submission" data-id="{{item.submission.submissionId}}" data-expected="{{item.submission.revisionId}}" disabled="{{busy || submissionSucceeded}}">查看文件</button><button class="action-button " bindtap="action" data-action="download" data-kind="submission" data-id="{{item.submission.submissionId}}" data-expected="{{item.submission.revisionId}}" disabled="{{busy || submissionSucceeded}}">下载文件</button></block><view wx:else class="muted">该次文件已覆盖，审计留存</view><button class="action-button primary" bindtap="action" data-action="approve" wx:if="{{item.canApprove}}" data-id="{{item.submission.submissionId}}" data-revision="{{item.expectedTaskRevision}}" disabled="{{busy || submissionSucceeded}}">通过</button><button bindtap="go" data-page="17" wx:if="{{item.canReject}}" data-submission="{{item.submission.submissionId}}">不通过</button></view><view wx:if="{{!items.length}}" class="empty">当前分类暂无提交</view><button bindtap="go" data-page="15" >返回任务概况</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="16"/>
