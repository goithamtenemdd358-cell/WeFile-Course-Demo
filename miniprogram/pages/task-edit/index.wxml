<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><text class="label">负责人（已加入成员，可选自己）</text><picker wx:if="{{members.length}}" range="{{members}}" range-key="displayName" value="{{memberIndex}}" bindchange="pick" data-field="memberIndex">{{members[memberIndex].displayName}}</picker><view wx:else class="muted">暂无其他成员；可把任务分配给自己，或先邀请组员加入。</view><text class="label">任务名称（选填）</text><input value="{{form.title}}" bindinput="input" data-field="title" data-form="true" maxlength="120"/><text class="label">任务详细描述</text><textarea value="{{form.description}}" bindinput="input" data-field="description" data-form="true" maxlength="8000"/><text class="label">成果要求</text><textarea value="{{form.requirements}}" bindinput="input" data-field="requirements" data-form="true" maxlength="4000"/><text class="label">截止时间（北京时间，选填）</text><view class="row"><picker mode="date" value="{{date}}" bindchange="pick" data-field="date">{{date || '选择日期'}}</picker><picker mode="time" value="{{clock}}" bindchange="pick" data-field="clock">{{clock || '23:59'}}</picker></view><button class="action-button " bindtap="action" data-action="saveTaskDraft"  disabled="{{busy || submissionSucceeded}}">保存草稿</button><button class="action-button primary" bindtap="action" data-action="publishTask"  disabled="{{busy || submissionSucceeded}}">{{editingTask?'保存修改':'创建并发布'}}</button><button class="action-button " bindtap="action" data-action="publishContinue"  disabled="{{busy || submissionSucceeded}}">保存并继续创建</button><button bindtap="back">取消</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="14"/>
