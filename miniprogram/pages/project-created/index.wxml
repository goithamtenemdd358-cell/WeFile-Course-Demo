<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><view class="card-title">{{project.fields.name}}</view><view class="code">{{project.inviteCode}}</view><view class="muted">复制六位邀请码，邀请组员加入。总DDL {{project.fields.dueAtText}}</view><button class="action-button " bindtap="action" data-action="copy"  disabled="{{busy || submissionSucceeded}}">复制邀请码</button><button bindtap="go" data-page="14" >创建第一个任务</button><button bindtap="go" data-page="07" >进入项目</button><button bindtap="go" data-page="03-A" >返回项目列表</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="06"/>
