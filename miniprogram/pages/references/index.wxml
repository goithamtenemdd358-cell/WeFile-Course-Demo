<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="filters"><view class="filter" bindtap="referenceFilter" data-value="">全部</view><view wx:for="{{categories}}" wx:key="value" class="filter {{referenceCategory===item.value?'active':''}}" bindtap="referenceFilter" data-value="{{item.value}}">{{item.label}}</view></view><view wx:for="{{items}}" wx:key="referenceId" class="card"><view class="card-title">{{item.name}}</view><view>{{item.description}}</view><view class="muted">{{item.extension}} · {{item.uploaderDisplayName}} · {{item.uploadedAtText}}</view><button class="action-button " bindtap="action" data-action="preview" data-kind="reference" data-id="{{item.referenceId}}" disabled="{{busy || submissionSucceeded}}">查看或预览</button><button class="action-button " bindtap="action" data-action="download" data-kind="reference" data-id="{{item.referenceId}}" disabled="{{busy || submissionSucceeded}}">下载文件</button><button class="action-button " bindtap="action" data-action="deleteReference" wx:if="{{isLeader}}" data-id="{{item.referenceId}}" data-revision="{{item.revision}}" disabled="{{busy || submissionSucceeded}}">删除文档</button></view><view wx:if="{{!items.length}}" class="empty">暂无参考文档</view><block wx:if="{{isLeader}}"><view class="section">参考文档</view><button class="action-button " bindtap="action" data-action="chooseReference"  disabled="{{busy || submissionSucceeded}}">选择参考文档</button><view wx:if="{{referenceName}}" class="card"><text>{{referenceName}}</text><text class="label">文件分类</text><picker range="{{categories}}" range-key="label" value="{{categoryIndex}}" data-field="categoryIndex" bindchange="pick">{{categories[categoryIndex].label}}</picker><text class="label">文件说明</text><textarea value="{{referenceDescription}}" bindinput="input" data-field="referenceDescription"  maxlength="2000"/><button class="action-button " bindtap="action" data-action="attachReference"  disabled="{{busy || submissionSucceeded}}">上传参考文档</button></view></block><button bindtap="go" data-page="07" >返回项目</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="09"/>
