<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card stats"><view class="stat"><view class="number">{{project.statistics.total}}</view><text>总任务</text></view><view class="stat"><view class="number">{{project.statistics.completed}}</view><text>已完成</text></view><view class="stat"><view class="number">{{project.statistics.awaitingReview}}</view><text>待审核</text></view><view class="stat"><view class="number">{{project.statistics.pending}}</view><text>未提交</text></view><view class="stat"><view class="number">{{project.statistics.changesRequested}}</view><text>需修改</text></view><view class="stat"><view class="number">{{project.statistics.overdue}}</view><text>已逾期</text></view><text class="muted">完成度 {{project.statistics.progress}}% · 未完成 {{project.statistics.unfinished}}</text></view><view class="section">任务草稿</view><view wx:for="{{drafts}}" wx:key="draftTaskId" class="card">{{item.fields.title || '未命名任务'}}<button bindtap="go" data-page="14" data-draft="{{item.draftTaskId}}">继续编辑草稿</button></view><view class="filters"><view wx:for="{{taskFilters}}" wx:key="value" wx:if="{{pageId!=='11'||item.value!=='ALL'}}" class="filter {{filter===item.value?'active':''}}" bindtap="filter" data-value="{{item.value}}">{{pageId==='15' && item.value==='PENDING' ? '未提交' : item.label}}</view></view><view wx:for="{{items}}" wx:key="taskId" class="card"><view bindtap="go" data-page="12" data-task="{{item.taskId}}" data-project="{{item.projectId}}"><view class="card-title">{{item.title}}</view><view class="muted">{{item.projectName}} {{item.assigneeDisplayName}}</view><text class="badge">{{item.stateText}}</text><text wx:if="{{item.isOverdue}}" class="badge late">已逾期</text><view class="muted">DDL {{item.effectiveDueAtText || item.dueAtText}}</view><view wx:if="{{item.currentSubmission}}" class="muted">V{{item.currentSubmission.displayNumber}} · {{item.currentSubmission.submittedAtText}}</view></view><block wx:if="{{pageId==='02-A' || pageId==='11'}}"><button bindtap="go" data-page="13" wx:if="{{item.quickAction==='FIRST_UPLOAD' || item.capabilities.canFirstUpload}}" data-task="{{item.taskId}}" data-project="{{item.projectId}}">上传文件</button><button bindtap="go" data-page="20" wx:if="{{item.quickAction==='RESUBMIT' || item.capabilities.canResubmit}}" data-task="{{item.taskId}}" data-project="{{item.projectId}}">重新提交</button></block><block wx:if="{{pageId==='15'}}"><button bindtap="go" data-page="14" data-task="{{item.taskId}}">修改任务</button><button class="action-button " bindtap="action" data-action="preview" wx:if="{{item.currentSubmission}}" data-kind="submission" data-id="{{item.currentSubmission.submissionId}}" data-expected="{{item.currentSubmission.revisionId}}" disabled="{{busy || submissionSucceeded}}">查看文件</button><button bindtap="go" data-page="16" wx:if="{{item.capabilities.canApprove}}" data-task="{{item.taskId}}">开始审核</button><button class="action-button " bindtap="action" data-action="remind" wx:if="{{item.capabilities.canRemind}}" data-id="{{item.taskId}}" data-revision="{{item.revision}}" disabled="{{busy || submissionSucceeded}}">提醒提交</button></block></view><view wx:if="{{!items.length && !loading}}" class="empty">暂无任务</view><button bindtap="go" data-page="14" >创建任务</button><button bindtap="go" data-page="07" >返回项目</button><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="15"/>
