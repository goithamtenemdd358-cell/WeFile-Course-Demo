<view class="page"><view class="head"><view wx:if="{{canBack}}" class="back" bindtap="back">‹</view><view class="title">{{title}}</view></view><view wx:if="{{loading}}" class="muted">加载中…</view><view wx:if="{{error}}" class="error">{{error}}<button class="action-button " bindtap="action" data-action="retry"  disabled="{{busy || submissionSucceeded}}">刷新重试</button></view><view class="card"><view class="card-title">{{reviewContext.taskRequirementsSnapshot.title}} · {{reviewContext.assigneeDisplayName}}</view><view>V{{reviewContext.submission.displayNumber}} · {{reviewContext.submission.submittedAtText}}</view><view class="body">{{reviewContext.taskRequirementsSnapshot.description}}<view>{{reviewContext.taskRequirementsSnapshot.requirements}}</view><view>{{reviewContext.taskRequirementsSnapshot.projectUnifiedRequirements}}</view></view><text class="label">修改意见（选填）</text><textarea value="{{reason}}" bindinput="input" data-field="reason"  maxlength="8000"/><text class="label">修改DDL（可选）</text><text class="label">截止时间（北京时间）</text><view class="row"><picker mode="date" value="{{date}}" bindchange="pick" data-field="date">{{date || '选择日期'}}</picker><picker mode="time" value="{{clock}}" bindchange="pick" data-field="clock">{{clock || '23:59'}}</picker></view><text class="label">重要程度</text><picker range="{{priorities}}" value="{{priorityIndex}}" bindchange="pick" data-field="priorityIndex">{{priorities[priorityIndex]}}</picker><button class="action-button primary" bindtap="action" data-action="reject" wx:if="{{reviewContext.canReview}}" disabled="{{busy || submissionSucceeded}}">发送修改意见</button><button bindtap="back">取消</button></view><button class="action-button " bindtap="action" data-action="more" wx:if="{{nextCursor}}" disabled="{{busy || submissionSucceeded}}">加载更多</button><view wx:if="{{busy}}" class="muted">正在处理，请稍候…</view></view><global-nav class="global-nav" active="17"/>
