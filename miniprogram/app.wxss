page{background:#f3f6f5;color:#183c33;font-family:system-ui,-apple-system,sans-serif;font-size:29rpx}.page{padding:28rpx 28rpx 160rpx}.head{display:flex;align-items:center;gap:24rpx;margin:14rpx 0 32rpx}.back{font-size:40rpx;padding:8rpx}.title{font-size:39rpx;font-weight:700}.subtitle,.muted{font-size:25rpx;color:#6f817b;line-height:1.6}.card{background:#fff;border:1rpx solid #e0e9e5;border-radius:22rpx;padding:28rpx;margin-bottom:24rpx}.card-title{font-weight:650;font-size:31rpx;margin-bottom:14rpx}.hero{background:#0d6656;color:white}.hero .muted{color:#d4e9e1}.row{display:flex;align-items:center;justify-content:space-between;gap:14rpx}.wrap{flex-wrap:wrap}.stats{display:flex;flex-wrap:wrap;gap:24rpx}.stat{min-width:120rpx;flex:1}.number{font-size:48rpx;font-weight:700}.label{display:block;color:#657d74;font-size:26rpx;margin:24rpx 0 12rpx}input,textarea,picker{background:#f3f6f5;border:1rpx solid #dbe5df;border-radius:12rpx;padding:20rpx;box-sizing:border-box;width:100%}input{height:88rpx;line-height:48rpx}textarea{height:170rpx;line-height:1.5}picker{min-height:88rpx;line-height:48rpx}button{min-height:88rpx;width:100%;display:flex;align-items:center;justify-content:center;line-height:1.5;box-sizing:border-box;font-size:28rpx;border-radius:14rpx;margin:16rpx 0;padding:3rpx 18rpx;background:#e5eee9;color:#145243}button.primary{background:#0c7660;color:#fff}button.danger{background:#fbe7e4;color:#a93730}button.small{font-size:24rpx;display:inline-block;padding:0 20rpx;margin:8rpx 10rpx 0 0}button::after{border:0}.error{padding:22rpx;border-radius:12rpx;background:#ffe8e1;color:#922f22;margin:16rpx 0}.empty{text-align:center;padding:60rpx 24rpx;color:#73847e}.badge{font-size:23rpx;padding:6rpx 15rpx;border-radius:10rpx;background:#e0f0e7;color:#20644d;display:inline-block}.late{background:#fff0dc;color:#985921;margin-left:8rpx}.filters{display:flex;flex-wrap:wrap;gap:10rpx;margin:18rpx 0}.filter{padding:12rpx 19rpx;border-radius:30rpx;background:#e6ede8;font-size:24rpx}.filter.active{background:#116e5a;color:#fff}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#dce8e1}.cover{width:100%;height:250rpx;border-radius:16rpx}.body{white-space:pre-wrap;line-height:1.7}.gap{height:20rpx}.file{padding:20rpx 0;border-bottom:1rpx solid #e7eeea}.code{letter-spacing:12rpx;font-size:56rpx;font-weight:700;text-align:center;margin:28rpx 0}.notice-unread{border-left:7rpx solid #138469}.footer-note{font-size:23rpx;color:#7e8e87;margin-top:24rpx}.radio-row{display:flex;align-items:center;margin:20rpx 0}.section{font-size:31rpx;font-weight:600;margin:30rpx 0 20rpx}
